{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": ".",
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "Package.swift" },
    { "path": "Sources" },
    {
      "kind": "folder",
      "path": "Sources/HorizontalNative",
      "target-membership": [
        "Horizontal",
        "HorizontalQuickLookPreview",
        "HorizontalQuickLookThumbnail",
      ],
      "membership-exceptions": [
        {
          "target": "HorizontalQuickLookPreview",
          "exclusions": [
            "HorizontalNativeApp.swift",
            "HorizontalNativeAppDelegate.swift",
            "Intents/HorizontalAppShortcuts.swift",
            "Intents/HorizontalIntents.swift",
            "Voice/HorizontalSpeechListener.swift",
          ],
        }, {
          "target": "HorizontalQuickLookThumbnail",
          "exclusions": [
            "HorizontalNativeApp.swift",
            "HorizontalNativeAppDelegate.swift",
            "Intents/HorizontalAppShortcuts.swift",
            "Intents/HorizontalIntents.swift",
            "Voice/HorizontalSpeechListener.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Sources/HorizontalQuickLookPreview", "target-membership": [ "HorizontalQuickLookPreview" ] },
    { "kind": "folder", "path": "Sources/HorizontalQuickLookThumbnail", "target-membership": [ "HorizontalQuickLookThumbnail" ] },
    { "path": "App/Resources/AppIcon.icon", "target-membership": [ "Horizontal/resources" ] },
    { "path": "App/Resources/Assets.xcassets", "target-membership": [ "Horizontal/resources" ] },
    { "path": "App" },
    { "path": "Tests" },
    { "path": "Vendor" },
    { "path": "scripts" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Horizontal.app", "id": "1A0000000000000000000011", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/HorizontalQuickLookPreview.appex", "id": "1A0000000000000000000012", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Horizontal/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/HorizontalQuickLookThumbnail.appex", "id": "1A0000000000000000000013", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Horizontal/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Horizontal",
      "id": "1A0000000000000000000200",
      "product": "Products/Horizontal.app",
      "product-type": "application",
      "dependencies": [
        { "target": "HorizontalQuickLookPreview", "platforms": [ "macos" ] },
        { "target": "HorizontalQuickLookThumbnail", "platforms": [ "macos" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Copy Third-Party Licenses",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Scripts/copy-third-party-licenses.sh",
            "$(SRCROOT)/Vendor/OpenCascadeStatic/macos-arm64/share/doc/opencascade/LICENSE_LGPL_21.txt",
            "$(SRCROOT)/Vendor/OpenCascadeStatic/macos-arm64/share/doc/opencascade/OCCT_LGPL_EXCEPTION.txt",
            "$(SRCROOT)/Vendor/RapidJSON/license.txt",
            "$(SRCROOT)/Vendor/Clipper/License.txt",
            "$(SRCROOT)/Vendor/earcut/LICENSE",
            "$(SRCROOT)/Vendor/Hersheyish/LICENSE",
            "$(SRCROOT)/Sources/HorizontalProjectIO/Resources/horizon-pool/LICENSE.md",
            "$(SRCROOT)/Sources/HorizontalProjectIO/Resources/horizon-pool/README.md",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/OpenCascade/LICENSE_LGPL_21.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/OpenCascade/OCCT_LGPL_EXCEPTION.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/RapidJSON/license.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/Clipper/License.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/earcut/LICENSE",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/Hershey/LICENSE",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/horizon-pool/LICENSE.md",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/horizon-pool/README.md",
          ],
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/Scripts/copy-third-party-licenses.sh\"\n",
        },
      ],
      "package-product-members": [
        {
          "product-name": "HorizontalPlaneClipper",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HorizontalProjectIO",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HorizontalStepImporter",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ALWAYS_SEARCH_USER_PATHS": "NO",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "NO",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphone*]": "App/Horizontal-iOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "App/Horizontal.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=xr*]": "App/Horizontal-iOS.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_INJECT_BASE_ENTITLEMENTS": "YES",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "2",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT": "dwarf-with-dsym",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "App/InfoXcode.plist",
        "INFOPLIST_FILE[sdk=iphoneos*]": "App/iOSInfo.plist",
        "INFOPLIST_FILE[sdk=iphonesimulator*]": "App/iOSInfo.plist",
        "INFOPLIST_FILE[sdk=xros*]": "App/iOSInfo.plist",
        "INFOPLIST_FILE[sdk=xrsimulator*]": "App/iOSInfo.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Horizontal",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Horizontal listens for spoken commands such as “highlight C12” or “show the board” while the microphone button is on.",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xros*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xrsimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.6.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.app.horizontal",
        "PRODUCT_NAME": "Horizontal",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "HorizontalQuickLookPreview",
      "id": "1A0000000000000000000210",
      "product": "Products/HorizontalQuickLookPreview.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "HorizontalPlaneClipper",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HorizontalProjectIO",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HorizontalStepImporter",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ALWAYS_SEARCH_USER_PATHS": "NO",
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS": "App/QuickLookExtension.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_INJECT_BASE_ENTITLEMENTS": "YES",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT": "dwarf-with-dsym",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "App/QuickLookPreview/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Horizontal Preview",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.6.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.app.horizontal.quicklook-preview",
        "PRODUCT_NAME": "HorizontalQuickLookPreview",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "HorizontalQuickLookThumbnail",
      "id": "1A0000000000000000000220",
      "product": "Products/HorizontalQuickLookThumbnail.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "HorizontalPlaneClipper",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HorizontalProjectIO",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HorizontalStepImporter",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ALWAYS_SEARCH_USER_PATHS": "NO",
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS": "App/QuickLookExtension.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_INJECT_BASE_ENTITLEMENTS": "YES",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT": "dwarf-with-dsym",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "App/QuickLookThumbnail/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Horizontal Thumbnail",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.6.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.app.horizontal.quicklook-thumbnail",
        "PRODUCT_NAME": "HorizontalQuickLookThumbnail",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ALWAYS_USE_SEPARATE_HEADERMAPS": "YES",
    "ARCHS": "arm64",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEVELOPMENT_TEAM": "257KW9ZJFP",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
  },
  "last-upgrade": "27.0",
}
